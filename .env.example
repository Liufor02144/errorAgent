# Docker Compose 必填项
MYSQL_DATABASE=erroragent
MYSQL_USER=erroragent
MYSQL_PASSWORD=change-this-database-password
MYSQL_ROOT_PASSWORD=change-this-root-password
ERRORAGENT_ADMIN_USERNAME=admin
ERRORAGENT_ADMIN_PASSWORD=change-this-admin-password

# 对外地址与总开关
ERRORAGENT_BASE_URL=http://localhost:8080
ERRORAGENT_ENABLED=false
ERRORAGENT_APP_PACKAGES=com.example
ERRORAGENT_STRIP_PREFIXES=

# 阿里云 SLS
SLS_ENDPOINT=
SLS_PROJECT=
SLS_LOGSTORE=
SLS_ACCESS_KEY_ID=
SLS_ACCESS_KEY_SECRET=
SLS_CONTAINER_PREFIX=
SLS_EXTRA_APP_IDS=

# OpenAI 兼容大模型接口
LLM_ENABLED=false
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_REDACT=true

# 飞书应用机器人
PUSH_ENABLED=false
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_CHAT_ID=

# 可选：源码定位使用的 Git 服务。token 只需仓库只读权限
GIT_BASE_URL=
GIT_USERNAME=oauth2
GIT_TOKEN=
GIT_LOCAL_PATH=/app/data/repos
